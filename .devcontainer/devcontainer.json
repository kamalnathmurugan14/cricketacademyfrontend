{
  "name": "Cricket Academy API",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "forwardPorts": [8080, 5173],
  "portsAttributes": {
    "8080": { "label": "Cricket Academy API", "onAutoForward": "notify" },
    "5173": { "label": "Frontend (when added)" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["vscjava.vscode-java-pack", "vmware.vscode-boot-dev-pack"]
    }
  },
  "postStartCommand": "nohup bash .devcontainer/start.sh > /tmp/api.log 2>&1 &"
}
